# Copy to .env and edit. Never commit the result: .gitignore already excludes it.
#
# Only DATABASE_URL and REDIS_URL have no default. Everything else below is
# shown with the value this build actually uses, so you can see what you are
# changing away from.

# --- Required ---------------------------------------------------------------

# Must NOT be the schema owner or any superuser. Postgres exempts superusers
# and BYPASSRLS roles from every row-level security policy, so connecting as
# one silently disables tenant isolation. /readyz refuses to report ready when
# it detects this. `scripts/bootstrap.py` provisions a suitable role and prints
# the URL to use here.
DATABASE_URL=postgresql+asyncpg://fhirbridge_app:CHANGE_ME@localhost:5432/fhirbridge

REDIS_URL=redis://localhost:6379/0

# --- Compose only -----------------------------------------------------------
# Consumed by docker-compose.yml, not by the application.
POSTGRES_USER=fhirbridge_owner
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=fhirbridge
APP_DB_USER=fhirbridge_app
APP_DB_PASSWORD=change-me-too
API_PORT=8000

# --- Dependencies -----------------------------------------------------------

VALIDATOR_URL=http://localhost:8081

# tx.fhir.org is the default the HL7 validator itself uses. Only codes are sent
# to it, never any surrounding clinical context, and it is the reason L3 can
# check SNOMED CT, LOINC and RxNorm at all without you loading them yourself.
# There is no SLA, and because this service fails closed on terminology, an
# outage there is an outage here. Point this at your own server for production.
TERMINOLOGY_URL=https://tx.fhir.org/r4
# none | basic | bearer. bearer additionally requires TERMINOLOGY_TOKEN.
TERMINOLOGY_AUTH_MODE=none

# --- Conformance ------------------------------------------------------------

# Must match what the validator image was built with: the validator's loaded IG
# set is fixed at startup, so asking the API to claim a profile the sidecar
# cannot resolve produces a fail-closed error rather than a false pass.
DEFAULT_IG_PACKAGES=hl7.fhir.us.core#9.0.0
DEFAULT_FHIR_VERSION=4.0.1

# Stamped into every validation report so a verdict can be reproduced later.
# The sidecar has no version endpoint, so this is asserted, not discovered: keep
# it equal to the VALIDATOR_VERSION the validator image was built with.
VALIDATOR_VERSION=6.10.2

# --- Environment and safety -------------------------------------------------

# development | staging | production. production additionally requires https
# for VALIDATOR_URL unless it is loopback, and forbids the two settings below.
FHIRBRIDGE_ENV=development

# Refuse readiness when Postgres reports that RLS does not apply to the
# connected role. Turn this off only if you accept that tenant isolation then
# rests on query construction alone.
REQUIRE_RLS_ENFORCEMENT=true

# Accept API keys over plaintext HTTP. Local development only; forbidden in
# production. Never enable with real PHI or real provider keys.
ALLOW_INSECURE_TRANSPORT=false

# --- BYOK / LLM (POST /v1/NAR2FHIR) ----------------------------------------
# fhirbridge calls no LLM of its own. Callers supply provider, model and key per
# request in X-LLM-* headers. These settings bound what that traffic may do.

# byok = only caller-supplied credentials (the server holds no key). The other
# modes (server_default, byok_or_default) require a server key and are not used
# by this build.
LLM_MODE=byok

# Comma-separated provider allowlist, or * for any. Providers are matched
# case-insensitively against X-LLM-Provider.
LLM_ALLOWED_PROVIDERS=*

# Comma-separated hostnames a caller-supplied endpoint may reach. This is the
# main egress control: it is empty by default, which blocks every external call.
# To use OpenRouter (the default provider), add its host:
#   LLM_EGRESS_ALLOWLIST=openrouter.ai
LLM_EGRESS_ALLOWLIST=

# When true, only loopback LLM endpoints are permitted (e.g. a local Ollama).
# Overrides the allowlist for external hosts.
LOCAL_ONLY_MODE=false

# Require X-PHI-Egress-Acknowledged: true before clinical content is sent to an
# external (non-loopback) provider. Leave on unless you have another control.
REQUIRE_PHI_EGRESS_ACK=true

# Minimum model qualification tier: unqualified | bronze | silver | gold. Unknown
# models resolve to 'unqualified', so the default 'bronze' refuses them. Lower
# this to 'unqualified' to allow arbitrary bring-your-own-model use.
MIN_QUALIFICATION_TIER=bronze

# Hard cap on the estimated worst-case cost of a single conversion, in USD.
MAX_COST_USD_PER_CONVERSION=1.00

# Record prompts and completions in logs. They contain PHI, so this is forbidden
# in production. Development debugging only.
DEBUG_CAPTURE_LLM_IO=false

# --- Observability ----------------------------------------------------------

LOG_LEVEL=INFO
JSON_LOGS=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Optional tuning --------------------------------------------------------

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
VALIDATOR_TIMEOUT_S=120
TERMINOLOGY_TIMEOUT_S=30
TERMINOLOGY_CACHE_TTL=24h
MAX_REPAIR_ITERATIONS=2
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=33554432
RETENTION_DEFAULT=30d

# Required in production. Generate 32 random bytes and encode them with
# URL-safe base64. Supply through deployment secret management, not a committed
# .env file.
# FHIRBRIDGE_EPHEMERAL_KEY=

# Persistent provider-credential storage is disabled in this release. If a
# future deployment enables it, FHIRBRIDGE_MASTER_KEY is also required.
CREDENTIAL_STORAGE=disabled
# FHIRBRIDGE_MASTER_KEY=

# For TERMINOLOGY_AUTH_MODE=basic:
# TERMINOLOGY_USERNAME=
# TERMINOLOGY_PASSWORD=
# For TERMINOLOGY_AUTH_MODE=bearer:
# TERMINOLOGY_TOKEN=
