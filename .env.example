# Copy to .env and edit. Never commit the result: .gitignore already excludes it.
#
# Only DATABASE_URL and REDIS_URL have no default. Everything else below is
# shown with the value this build actually uses, so you can see what you are
# changing away from.

# --- Required ---------------------------------------------------------------

# Must NOT be the schema owner or any superuser. Postgres exempts superusers
# and BYPASSRLS roles from every row-level security policy, so connecting as
# one silently disables tenant isolation. /readyz refuses to report ready when
# it detects this. `scripts/bootstrap.py` provisions a suitable role and prints
# the URL to use here.
DATABASE_URL=postgresql+asyncpg://fhirbridge_app:CHANGE_ME@localhost:5432/fhirbridge

REDIS_URL=redis://localhost:6379/0

# --- Compose only -----------------------------------------------------------
# Consumed by docker-compose.yml, not by the application.
POSTGRES_USER=fhirbridge_owner
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=fhirbridge
APP_DB_USER=fhirbridge_app
APP_DB_PASSWORD=change-me-too
API_PORT=8000

# --- Dependencies -----------------------------------------------------------

VALIDATOR_URL=http://localhost:8081

# tx.fhir.org is the default the HL7 validator itself uses. Only codes are sent
# to it, never any surrounding clinical context, and it is the reason L3 can
# check SNOMED CT, LOINC and RxNorm at all without you loading them yourself.
# There is no SLA, and because this service fails closed on terminology, an
# outage there is an outage here. Point this at your own server for production.
TERMINOLOGY_URL=https://tx.fhir.org/r4
# none | basic | bearer. bearer additionally requires TERMINOLOGY_TOKEN.
TERMINOLOGY_AUTH_MODE=none

# --- Conformance ------------------------------------------------------------

# Must match what the validator image was built with: the validator's loaded IG
# set is fixed at startup, so asking the API to claim a profile the sidecar
# cannot resolve produces a fail-closed error rather than a false pass.
DEFAULT_IG_PACKAGES=hl7.fhir.us.core#9.0.0
DEFAULT_FHIR_VERSION=4.0.1

# --- Environment and safety -------------------------------------------------

# development | staging | production. production additionally requires https
# for VALIDATOR_URL unless it is loopback, and forbids the two settings below.
FHIRBRIDGE_ENV=development

# Refuse readiness when Postgres reports that RLS does not apply to the
# connected role. Turn this off only if you accept that tenant isolation then
# rests on query construction alone.
REQUIRE_RLS_ENFORCEMENT=true

# Accept API keys over plaintext HTTP. Local development only; forbidden in
# production. Never enable with real PHI or real provider keys.
ALLOW_INSECURE_TRANSPORT=false

# --- Observability ----------------------------------------------------------

LOG_LEVEL=INFO
JSON_LOGS=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
